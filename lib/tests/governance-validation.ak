const script_address =
  Address {
    payment_credential: Script(governance_policy),
    stake_credential: None,
  }

const proposer_address =
  Address {
    payment_credential: VerificationKey(proposer_payment_hash),
    stake_credential: Some(Inline(VerificationKey(proposer_stake_hash))),
  }

fn datum_from_cbor(bytes: ByteArray) -> Data {
  expect Some(data) = cbor.deserialise(bytes)
  data
}

fn input(tx_id: ByteArray, output_index: Int) -> Input {
  Input {
    output_reference: OutputReference { transaction_id: tx_id, output_index },
    output: Output {
      address: proposer_address,
      value: assets.from_lovelace(0),
      datum: NoDatum,
      reference_script: None,
    },
  }
}

const root_value =
  assets.from_lovelace(add_proposal_output_0_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, root_asset_name, 1))

const proposal_node_value =
  assets.from_lovelace(add_proposal_output_1_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, node_asset_name, 1))

const mint_pass_root_value =
  assets.from_lovelace(mint_pass_output_0_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, root_asset_name, 1))

const pass_nft_value =
  assets.from_lovelace(mint_pass_output_1_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, pass_asset_name, 1))

const add_proposal_outputs =
  [
    Output {
      address: script_address,
      value: root_value,
      datum: InlineDatum(datum_from_cbor(add_proposal_output_0_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: script_address,
      value: proposal_node_value,
      datum: InlineDatum(datum_from_cbor(add_proposal_output_1_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: proposer_address,
      value: assets.from_lovelace(add_proposal_output_2_lovelace),
      datum: NoDatum,
      reference_script: None,
    },
  ]

const add_proposal_inputs =
  [
    input(add_proposal_input_0_tx_id, add_proposal_input_0_output_index),
    input(add_proposal_input_1_tx_id, add_proposal_input_1_output_index),
  ]

const add_proposal_reference_inputs =
  [
    input(
      add_proposal_reference_input_0_tx_id,
      add_proposal_reference_input_0_output_index,
    ),
  ]

const add_proposal_mint =
  assets.from_asset(governance_policy, node_asset_name, 1)

const add_proposal_redeemer =
  AddProposal {
    anchor_output_index: add_proposal_anchor_output_index,
    proposal_node_output_index: add_proposal_proposal_node_output_index,
    ttl: add_proposal_ttl,
    collateral_inputs: add_proposal_collateral_inputs_cbor,
    collateral_output: add_proposal_collateral_output_cbor,
    collateral_fee: add_proposal_collateral_fee_cbor,
  }

const mint_pass_outputs =
  [
    Output {
      address: script_address,
      value: mint_pass_root_value,
      datum: InlineDatum(datum_from_cbor(mint_pass_output_0_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: script_address,
      value: pass_nft_value,
      datum: InlineDatum(datum_from_cbor(mint_pass_output_1_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: proposer_address,
      value: assets.from_lovelace(mint_pass_output_2_lovelace),
      datum: NoDatum,
      reference_script: None,
    },
  ]

const mint_pass_inputs =
  [
    input(mint_pass_input_0_tx_id, mint_pass_input_0_output_index),
    input(mint_pass_input_1_tx_id, mint_pass_input_1_output_index),
    input(mint_pass_input_2_tx_id, mint_pass_input_2_output_index),
  ]

const mint_pass_reference_inputs =
  [
    input(
      mint_pass_reference_input_0_tx_id,
      mint_pass_reference_input_0_output_index,
    ),
  ]

const mint_pass_mint =
  assets.from_asset(governance_policy, node_asset_name, -1)
    |> assets.merge(assets.from_asset(governance_policy, pass_asset_name, 1))

const mint_pass_redeemer =
  MintProposalPassNFT {
    anchor_input_outref: OutputReference {
      transaction_id: mint_pass_input_0_tx_id,
      output_index: mint_pass_input_0_output_index,
    },
    anchour_output_index: mint_pass_anchor_output_index,
    passage_utxo_output_index: mint_pass_passage_utxo_output_index,
    ttl: mint_pass_ttl,
    collateral_inputs: mint_pass_collateral_inputs_cbor,
    collateral_output: mint_pass_collateral_output_cbor,
    collateral_fee: mint_pass_collateral_fee_cbor,
  }

test success__validate_add_proposal_script_data_hash() {
  expect trace_add_proposal_fixtures()

  validate_add_proposal_script_data_hash(
    add_proposal_script_data_hash,
    initial_cost_model,
    add_proposal_spend_cpu,
    add_proposal_spend_mem,
    add_proposal_mint_cpu,
    add_proposal_mint_mem,
    add_proposal_spend_redeemer_index,
    add_proposal_redeemer,
  )
}

test success__validate_pass_script_data_hash() {
  expect trace_mint_pass_fixtures()

  validate_pass_script_data_hash(
    mint_pass_script_data_hash,
    accepted_cost_model,
    mint_pass_anchor_spend_cpu,
    mint_pass_anchor_spend_mem,
    mint_pass_proposal_spend_cpu,
    mint_pass_proposal_spend_mem,
    mint_pass_mint_cpu,
    mint_pass_mint_mem,
    mint_pass_anchor_spend_redeemer_index,
    mint_pass_proposal_spend_redeemer_index,
    mint_pass_redeemer,
  )
}

test success__validate_tx_id_from_script_data_hash() {
  expect trace_add_proposal_fixtures()
  expect trace_mint_pass_fixtures()

  validate_tx_id_from_script_data_hash(
    add_proposal_tx_id,
    add_proposal_script_data_hash,
    add_proposal_inputs,
    add_proposal_reference_inputs,
    add_proposal_outputs,
    add_proposal_fee,
    add_proposal_ttl,
    add_proposal_mint,
    [proposer_payment_hash],
    add_proposal_collateral_inputs_cbor,
    add_proposal_collateral_output_cbor,
    add_proposal_collateral_fee_cbor,
  )
}

test success__validate_pass_tx_id_from_script_data_hash() {
  expect trace_mint_pass_fixtures()

  validate_tx_id_from_script_data_hash(
    mint_pass_tx_id,
    mint_pass_script_data_hash,
    mint_pass_inputs,
    mint_pass_reference_inputs,
    mint_pass_outputs,
    mint_pass_fee,
    mint_pass_ttl,
    mint_pass_mint,
    [proposer_payment_hash],
    mint_pass_collateral_inputs_cbor,
    mint_pass_collateral_output_cbor,
    mint_pass_collateral_fee_cbor,
  )
}
