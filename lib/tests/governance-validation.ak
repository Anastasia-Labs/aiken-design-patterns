fn trace_add_proposal_fixtures() -> Bool {
  trace @"add_proposal.tx_cbor": add_proposal_tx_cbor
  trace @"add_proposal.tx_body_cbor": add_proposal_tx_body_cbor
  True
}

fn trace_mint_pass_fixtures() -> Bool {
  trace @"mint_pass.tx_cbor": mint_pass_tx_cbor
  trace @"mint_pass.tx_body_cbor": mint_pass_tx_body_cbor
  trace @"mint_pass.pass_asset_name": pass_asset_name
  trace @"mint_pass.required_withdrawal_script_hash": required_withdrawal_script_hash
  trace @"mint_pass.accepted_cost_model": accepted_cost_model
  trace @"mint_pass.tx_id": mint_pass_tx_id
  trace @"mint_pass.script_data_hash": mint_pass_script_data_hash
  trace @"mint_pass.collateral_inputs_cbor": mint_pass_collateral_inputs_cbor
  trace @"mint_pass.collateral_output_cbor": mint_pass_collateral_output_cbor
  trace @"mint_pass.collateral_fee_cbor": mint_pass_collateral_fee_cbor
  trace @"mint_pass.input_0_tx_id": mint_pass_input_0_tx_id
  trace @"mint_pass.input_0_output_index": mint_pass_input_0_output_index
  trace @"mint_pass.input_1_tx_id": mint_pass_input_1_tx_id
  trace @"mint_pass.input_1_output_index": mint_pass_input_1_output_index
  trace @"mint_pass.input_2_tx_id": mint_pass_input_2_tx_id
  trace @"mint_pass.input_2_output_index": mint_pass_input_2_output_index
  trace @"mint_pass.reference_input_0_tx_id": mint_pass_reference_input_0_tx_id
  trace @"mint_pass.reference_input_0_output_index": mint_pass_reference_input_0_output_index
  trace @"mint_pass.output_0_lovelace": mint_pass_output_0_lovelace
  trace @"mint_pass.output_0_datum_cbor": mint_pass_output_0_datum_cbor
  trace @"mint_pass.output_1_lovelace": mint_pass_output_1_lovelace
  trace @"mint_pass.output_1_datum_cbor": mint_pass_output_1_datum_cbor
  trace @"mint_pass.output_2_lovelace": mint_pass_output_2_lovelace
  True
}

fn script_address() -> Address {
  Address {
    payment_credential: Script(governance_policy),
    stake_credential: None,
  }
}

fn proposer_address() -> Address {
  Address {
    payment_credential: VerificationKey(proposer_payment_hash),
    stake_credential: Some(Inline(VerificationKey(proposer_stake_hash))),
  }
}

fn datum_from_cbor(bytes: ByteArray) -> Data {
  expect Some(data) = cbor.deserialise(bytes)
  data
}

fn input(tx_id: ByteArray, output_index: Int) -> Input {
  Input {
    output_reference: OutputReference { transaction_id: tx_id, output_index },
    output: Output {
      address: proposer_address(),
      value: assets.from_lovelace(0),
      datum: NoDatum,
      reference_script: None,
    },
  }
}

fn root_value() -> Value {
  assets.from_lovelace(add_proposal_output_0_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, root_asset_name, 1))
}

fn proposal_node_value() -> Value {
  assets.from_lovelace(add_proposal_output_1_lovelace)
    |> assets.merge(assets.from_asset(governance_policy, node_asset_name, 1))
}

fn add_proposal_outputs() -> List<Output> {
  [
    Output {
      address: script_address(),
      value: root_value(),
      datum: InlineDatum(datum_from_cbor(add_proposal_output_0_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: script_address(),
      value: proposal_node_value(),
      datum: InlineDatum(datum_from_cbor(add_proposal_output_1_datum_cbor)),
      reference_script: None,
    },
    Output {
      address: proposer_address(),
      value: assets.from_lovelace(add_proposal_output_2_lovelace),
      datum: NoDatum,
      reference_script: None,
    },
  ]
}

fn add_proposal_inputs() -> List<Input> {
  [
    input(add_proposal_input_0_tx_id, add_proposal_input_0_output_index),
    input(add_proposal_input_1_tx_id, add_proposal_input_1_output_index),
  ]
}

fn add_proposal_reference_inputs() -> List<Input> {
  [
    input(
      add_proposal_reference_input_0_tx_id,
      add_proposal_reference_input_0_output_index,
    ),
  ]
}

fn add_proposal_mint() -> Value {
  assets.from_asset(governance_policy, node_asset_name, 1)
}

fn add_proposal_redeemer() -> MintRedeemer {
  AddProposal {
    anchor_output_index: add_proposal_anchor_output_index,
    proposal_node_output_index: add_proposal_proposal_node_output_index,
    ttl: add_proposal_ttl,
    collateral_inputs: add_proposal_collateral_inputs_cbor,
    collateral_output: add_proposal_collateral_output_cbor,
    collateral_fee: add_proposal_collateral_fee_cbor,
  }
}

test success__validate_add_proposal_script_data_hash() {
  expect trace_add_proposal_fixtures()

  validate_add_proposal_script_data_hash(
    add_proposal_script_data_hash,
    initial_cost_model,
    spend_cpu,
    spend_mem,
    mint_cpu,
    mint_mem,
    add_proposal_spend_redeemer_index,
    add_proposal_redeemer(),
  )
}

test success__validate_tx_id_from_script_data_hash() {
  expect trace_add_proposal_fixtures()
  expect trace_mint_pass_fixtures()

  validate_tx_id_from_script_data_hash(
    add_proposal_tx_id,
    add_proposal_script_data_hash,
    add_proposal_inputs(),
    add_proposal_reference_inputs(),
    add_proposal_outputs(),
    add_proposal_fee,
    add_proposal_ttl,
    add_proposal_mint(),
    [proposer_payment_hash],
    add_proposal_collateral_inputs_cbor,
    add_proposal_collateral_output_cbor,
    add_proposal_collateral_fee_cbor,
  )
}
