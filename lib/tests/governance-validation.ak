fn trace_add_proposal_fixtures() -> Bool {
  trace @"add_proposal.tx_cbor": add_proposal_tx_cbor
  trace @"add_proposal.tx_body_cbor": add_proposal_tx_body_cbor
  trace @"add_proposal.script_data_hash": add_proposal_script_data_hash
  trace @"add_proposal.spend_cpu": add_proposal_spend_cpu
  trace @"add_proposal.spend_mem": add_proposal_spend_mem
  trace @"add_proposal.mint_cpu": add_proposal_mint_cpu
  trace @"add_proposal.mint_mem": add_proposal_mint_mem
  True
}

fn trace_mint_pass_fixtures() -> Bool {
  trace @"mint_pass.tx_cbor": mint_pass_tx_cbor
  trace @"mint_pass.tx_body_cbor": mint_pass_tx_body_cbor
  trace @"mint_pass.pass_asset_name": pass_asset_name
  trace @"mint_pass.required_withdrawal_script_hash": required_withdrawal_script_hash
  trace @"mint_pass.accepted_cost_model": accepted_cost_model
  trace @"mint_pass.tx_id": mint_pass_tx_id
  trace @"mint_pass.script_data_hash": mint_pass_script_data_hash
  trace @"mint_pass.anchor_spend_cpu": mint_pass_anchor_spend_cpu
  trace @"mint_pass.anchor_spend_mem": mint_pass_anchor_spend_mem
  trace @"mint_pass.proposal_spend_cpu": mint_pass_proposal_spend_cpu
  trace @"mint_pass.proposal_spend_mem": mint_pass_proposal_spend_mem
  trace @"mint_pass.mint_cpu": mint_pass_mint_cpu
  trace @"mint_pass.mint_mem": mint_pass_mint_mem
  trace @"mint_pass.collateral_inputs_cbor": mint_pass_collateral_inputs_cbor
  trace @"mint_pass.collateral_output_cbor": mint_pass_collateral_output_cbor
  trace @"mint_pass.collateral_fee_cbor": mint_pass_collateral_fee_cbor
  trace @"mint_pass.input_0_tx_id": mint_pass_input_0_tx_id
  trace @"mint_pass.input_0_output_index": mint_pass_input_0_output_index
  trace @"mint_pass.input_1_tx_id": mint_pass_input_1_tx_id
  trace @"mint_pass.input_1_output_index": mint_pass_input_1_output_index
  trace @"mint_pass.input_2_tx_id": mint_pass_input_2_tx_id
