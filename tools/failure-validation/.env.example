# Copy this file to .env. The runner loads it automatically.
# Exported shell variables take precedence over values in .env.
# Networks: Custom (local emulator), Mainnet, Preprod, Preview.
NETWORK=Custom

# Required for Mainnet, Preprod, and Preview; ignored for Custom.
BLOCKFROST_API_KEY=
WALLET_SEED=""

# Optional compiler executable. Uses aiken from PATH when omitted.
# AIKEN=aiken
